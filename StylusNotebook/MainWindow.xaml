<Window x:Class="StylusNotebook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Native Stylus Notebook" Height="800" Width="1000"
        WindowStartupLocation="CenterScreen">
    
    <Grid Background="#f0f2f5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2c3e50" Padding="20">
            <TextBlock x:Name="QuestionText" Text="Loading Question..." Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        </Border>

        <!-- Ink Canvas -->
        <Grid Grid.Row="1">
            <!-- The InkCanvas natively handles Stylus pressure and the physical Eraser! -->
            <InkCanvas x:Name="MyInkCanvas" Background="White" 
                       TouchDown="MyInkCanvas_TouchDown"
                       StylusDown="MyInkCanvas_StylusDown" />
            
            <Border x:Name="Overlay" Background="#CC2c3e50" Visibility="Collapsed">
                <TextBlock x:Name="OverlayText" Text="Reading handwriting..." Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Footer Controls -->
        <Border Grid.Row="2" Background="#ecf0f1" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Clear Page" Padding="20,10" Background="#e74c3c" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Click="ClearBtn_Click"/>
                <Button Grid.Column="2" Content="Next Question ➔" Padding="20,10" Background="#3498db" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Click="NextBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
